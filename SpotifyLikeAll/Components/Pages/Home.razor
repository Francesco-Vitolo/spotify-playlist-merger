@page "/"
@rendermode InteractiveServer
@inject SpotifyAuthService Auth
@inject PlaylistLoader Loader
@inject LibraryService Library

<PageTitle>Spotify Like All</PageTitle>

@if (!Auth.IsConfigured)
{
    <section class="card">
        <h2>Spotify app not configured</h2>
        <p>Store the Client ID and Client Secret from the Spotify dashboard as user secrets, then restart the app:</p>
        <pre>dotnet user-secrets set "Spotify:ClientId" "&lt;client id&gt;" --project SpotifyLikeAll
dotnet user-secrets set "Spotify:ClientSecret" "&lt;client secret&gt;" --project SpotifyLikeAll</pre>
    </section>
}
else if (!Auth.IsLoggedIn)
{
    <section class="card login">
        <h2>Connect your Spotify account</h2>
        <p>You only need to do this once; the login is remembered for up to 180 days.</p>
        @if (!string.IsNullOrEmpty(error ?? LoginError))
        {
            <div class="error">@(error ?? LoginError)</div>
        }
        <a class="button primary" href="/login" data-enhance-nav="false">Log in with Spotify</a>
    </section>
}
else
{
    <div class="toolbar">
        <button class="primary" @onclick="LoadAsync" disabled="@Busy">
            @(loading ? "Loading …" : "Reload")
        </button>

        @if (result is not null && !loading)
        {
            <input type="search" placeholder="Filter by title or artist…" @bind="filter" @bind:event="oninput" />
            <label class="check"><input type="checkbox" @bind="onlyNotLiked" /> Only not yet liked</label>
            <label class="check"><input type="checkbox" @bind="hideDuplicates" /> Hide duplicates</label>
            <label class="check dry-run"><input type="checkbox" @bind="dryRun" /> Dry run</label>
        }

        @if (Busy)
        {
            <span class="status">@status</span>
        }

        <span class="account">
            @if (result is not null)
            {
                <span>@(result.Me.DisplayName ?? result.Me.Id)</span>
            }
            <a class="link" href="/logout" data-enhance-nav="false">Log out</a>
        </span>
    </div>

    @if (error is not null)
    {
        <div class="error">@error</div>
    }

    @if (result is not null && likedKeys is not null)
    {
        <p class="summary">
            @result.Owned.Count playlists
            · @result.Registry.Count unique songs
            · <strong>@NotLikedCount not yet liked</strong>
            · @AlreadyLikedCount already liked
            @if (likedThisSession > 0)
            {
                <span> · <strong class="ok">@likedThisSession liked in this session</strong></span>
            }
        </p>

        @if (NotLikedCount == 0)
        {
            <div class="card done">✔ Every song in your playlists is liked.</div>
        }

        @foreach (var playlist in result.Owned)
        {
            var rows = BuildRows(playlist);
            var visible = rows.Where(IsVisible).ToList();
            var pending = PendingTracks(playlist);
            var selectedCount = pending.Count(IsSelected);
            var isSkipped = skipped.Contains(playlist.Id);

            if ((IsFiltering || onlyNotLiked) && visible.Count == 0 && !messages.ContainsKey(playlist.Id))
            {
                continue;
            }

            <details class="playlist @(isSkipped ? "is-skipped" : null)" open="@IsFiltering">
                <summary>
                    <span class="name">@playlist.Name</span>
                    <span class="meta">
                        @playlist.Entries.Count songs
                        @if (isSkipped)
                        {
                            <span class="badge muted">skipped</span>
                        }
                        else if (pending.Count == 0)
                        {
                            <span class="badge ok">✔ all liked</span>
                        }
                        else
                        {
                            <span class="badge">@pending.Count not yet liked</span>
                        }
                    </span>
                </summary>

                @if (pending.Count > 0 && !isSkipped)
                {
                    <div class="actions">
                        <button class="primary" disabled="@(Busy || selectedCount == 0)"
                                @onclick="() => LikeSelectedAsync(playlist)">
                            @(dryRun ? "Dry run: like" : "Like") @selectedCount selected
                        </button>
                        <button class="secondary" disabled="@Busy" @onclick="() => SetSelection(playlist, true)">Select all</button>
                        <button class="secondary" disabled="@Busy" @onclick="() => SetSelection(playlist, false)">Select none</button>
                        <button class="secondary" disabled="@Busy" @onclick="() => ToggleSkip(playlist)">Skip playlist</button>
                        @if (busyPlaylistId == playlist.Id)
                        {
                            <span class="status">@status</span>
                        }
                    </div>
                }
                else if (isSkipped)
                {
                    <div class="actions">
                        <button class="secondary" disabled="@Busy" @onclick="() => ToggleSkip(playlist)">Undo skip</button>
                    </div>
                }

                @if (messages.TryGetValue(playlist.Id, out var message))
                {
                    <p class="message">@message</p>
                }

                @if (visible.Count == 0)
                {
                    <p class="empty">No songs to show.</p>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th class="sel"></th><th class="num">#</th><th>Title</th><th>Artist</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in visible)
                            {
                                var track = row.Entry.Track;
                                var canSelect = !row.IsLiked && row.IsFirstInPlaylist && !isSkipped;

                                <tr class="@(row.IsLiked ? "liked" : !row.IsFirstInPlaylist ? "dup" : null)">
                                    <td class="sel">
                                        @if (canSelect)
                                        {
                                            <input type="checkbox" checked="@IsSelected(track)" disabled="@Busy"
                                                   @onchange="e => SetSelected(track, e.Value is true)" />
                                        }
                                    </td>
                                    <td class="num">@(row.Index + 1)</td>
                                    <td>@track.Name</td>
                                    <td>@track.Artists</td>
                                    <td class="note">@Note(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (playlist.SkippedNonTracks > 0)
                {
                    <p class="hint">@playlist.SkippedNonTracks episodes, local files or unavailable items ignored.</p>
                }
            </details>
        }

        @if (result.NotOwned.Count > 0)
        {
            <details class="playlist skipped">
                <summary>
                    <span class="name">Not owned by you – ignored</span>
                    <span class="meta">@result.NotOwned.Count playlists</span>
                </summary>
                <ul>
                    @foreach (var p in result.NotOwned)
                    {
                        <li>@p.Name <span class="hint">by @p.OwnerName</span></li>
                    }
                </ul>
            </details>
        }
    }
}

@code {
    [SupplyParameterFromQuery]
    public string? LoginError { get; set; }

    private sealed record Row(PlaylistTrackEntry Entry, int Index, bool IsFirstInPlaylist, bool IsLiked);

    private PlaylistLoader.Result? result;
    private HashSet<string>? likedKeys;

    // Songs the user unticked (by dedupe key). Everything not yet liked is selected by default.
    private readonly HashSet<string> deselected = new();
    private readonly HashSet<string> skipped = new();
    private readonly Dictionary<string, string> messages = new();

    private bool loading;
    private string? busyPlaylistId;
    private string? status;
    private string? error;
    private int likedThisSession;

    private string filter = "";
    private bool onlyNotLiked = true;
    private bool hideDuplicates;
    private bool dryRun;

    private bool Busy => loading || busyPlaylistId is not null;

    private bool IsFiltering => !string.IsNullOrWhiteSpace(filter);

    private IEnumerable<string> AllKeys =>
        result?.Owned.SelectMany(p => p.Entries).Select(e => e.Track.DedupeKey).Distinct() ?? [];

    private int NotLikedCount => AllKeys.Count(k => likedKeys?.Contains(k) != true);

    private int AlreadyLikedCount => AllKeys.Count(k => likedKeys?.Contains(k) == true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Load automatically once the interactive connection is up (runs only once, not during prerendering).
        if (firstRender && Auth.IsConfigured && Auth.IsLoggedIn && result is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        status = "Loading playlists …";
        StateHasChanged();

        try
        {
            var loaded = await Loader.LoadOwnedPlaylistsAsync(ReportProgress);
            var liked = await Library.GetLikedKeysAsync(loaded.Owned, ReportProgress);

            result = loaded;
            likedKeys = liked;
            deselected.Clear();
            skipped.Clear();
            messages.Clear();
        }
        catch (Exception ex) when (TryHandle(ex))
        {
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LikeSelectedAsync(OwnedPlaylist playlist)
    {
        if (likedKeys is null)
            return;

        var tracks = PendingTracks(playlist).Where(IsSelected).ToList();
        if (tracks.Count == 0)
            return;

        if (dryRun)
        {
            messages[playlist.Id] = $"Dry run: {tracks.Count} songs would be liked. Nothing was changed.";
            return;
        }

        busyPlaylistId = playlist.Id;
        error = null;
        status = $"Liking songs … 0/{tracks.Count}";
        messages.Remove(playlist.Id);
        StateHasChanged();

        var before = likedKeys.Count;
        try
        {
            var count = await Library.LikeAsync(tracks, playlist.Name, likedKeys, ReportProgress);
            likedThisSession += count;
            messages[playlist.Id] = $"✔ Liked {count} songs.";
        }
        catch (Exception ex) when (TryHandle(ex))
        {
            // Batches that succeeded before the error are already in likedKeys.
            var partial = likedKeys.Count - before;
            if (partial > 0)
            {
                likedThisSession += partial;
                messages[playlist.Id] = $"Liked {partial} songs before an error occurred.";
            }
        }
        finally
        {
            busyPlaylistId = null;
            StateHasChanged();
        }
    }

    private void ReportProgress(string message)
    {
        status = message;
        _ = InvokeAsync(StateHasChanged);
    }

    private bool TryHandle(Exception ex)
    {
        switch (ex)
        {
            case NotLoggedInException:
                // Session expired or revoked: the page falls back to the login card.
                result = null;
                likedKeys = null;
                error = ex.Message;
                return true;
            case SpotifyAuthException or SpotifyApiException:
                error = ex.Message;
                return true;
            case HttpRequestException:
                error = $"Network error: {ex.Message}";
                return true;
            default:
                return false;
        }
    }

    private List<Row> BuildRows(OwnedPlaylist playlist)
    {
        var seenInPlaylist = new HashSet<string>();
        return playlist.Entries
            .Select((entry, index) => new Row(
                entry,
                index,
                seenInPlaylist.Add(entry.Track.DedupeKey),
                likedKeys?.Contains(entry.Track.DedupeKey) == true))
            .ToList();
    }

    private bool IsVisible(Row row)
    {
        if (onlyNotLiked && (row.IsLiked || !row.IsFirstInPlaylist))
            return false;

        if (hideDuplicates && row.Entry.Duplicate != DuplicateKind.None)
            return false;

        return !IsFiltering
               || row.Entry.Track.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || row.Entry.Track.Artists.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Songs of this playlist that are not liked yet, each song only once.</summary>
    private List<Track> PendingTracks(OwnedPlaylist playlist) =>
        playlist.Entries
            .Select(e => e.Track)
            .Where(t => likedKeys?.Contains(t.DedupeKey) != true)
            .DistinctBy(t => t.DedupeKey)
            .ToList();

    private bool IsSelected(Track track) => !deselected.Contains(track.DedupeKey);

    private void SetSelected(Track track, bool selected)
    {
        if (selected)
            deselected.Remove(track.DedupeKey);
        else
            deselected.Add(track.DedupeKey);
    }

    private void SetSelection(OwnedPlaylist playlist, bool selected)
    {
        foreach (var track in PendingTracks(playlist))
            SetSelected(track, selected);
    }

    private void ToggleSkip(OwnedPlaylist playlist)
    {
        if (!skipped.Remove(playlist.Id))
            skipped.Add(playlist.Id);
        messages.Remove(playlist.Id);
    }

    private static string Note(Row row)
    {
        if (row.IsLiked)
            return "♥ Liked";

        if (!row.IsFirstInPlaylist)
            return "Duplicate in this playlist";

        return row.Entry.Duplicate == DuplicateKind.OtherPlaylist
            ? $"Also in \"{row.Entry.FirstSeenInPlaylist}\""
            : "";
    }
}
