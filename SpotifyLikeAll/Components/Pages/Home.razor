@page "/"
@rendermode InteractiveServer
@inject SpotifyAuthService Auth
@inject PlaylistLoader Loader

<PageTitle>Spotify Like All</PageTitle>

@if (!Auth.IsConfigured)
{
    <section class="card">
        <h2>Spotify app not configured</h2>
        <p>Store the Client ID and Client Secret from the Spotify dashboard as user secrets, then restart the app:</p>
        <pre>dotnet user-secrets set "Spotify:ClientId" "&lt;client id&gt;" --project SpotifyLikeAll
dotnet user-secrets set "Spotify:ClientSecret" "&lt;client secret&gt;" --project SpotifyLikeAll</pre>
    </section>
}
else if (!Auth.IsLoggedIn)
{
    <section class="card login">
        <h2>Connect your Spotify account</h2>
        <p>You only need to do this once; the login is remembered for up to 180 days.</p>
        @if (!string.IsNullOrEmpty(error ?? LoginError))
        {
            <div class="error">@(error ?? LoginError)</div>
        }
        <a class="button primary" href="/login" data-enhance-nav="false">Log in with Spotify</a>
    </section>
}
else
{
    <div class="toolbar">
        <button class="primary" @onclick="LoadAsync" disabled="@loading">
            @(loading ? "Loading …" : "Reload")
        </button>

        @if (result is not null && !loading)
        {
            <input type="search" placeholder="Filter by title or artist…" @bind="filter" @bind:event="oninput" />
            <label class="check">
                <input type="checkbox" @bind="hideDuplicates" /> Hide duplicates
            </label>
        }

        @if (loading)
        {
            <span class="status">@status</span>
        }

        <span class="account">
            @if (result is not null)
            {
                <span>@(result.Me.DisplayName ?? result.Me.Id)</span>
            }
            <a class="link" href="/logout" data-enhance-nav="false">Log out</a>
        </span>
    </div>

    @if (error is not null)
    {
        <div class="error">@error</div>
    }

    @if (result is not null)
    {
        <p class="summary">
            @result.Owned.Count playlists
            · @TotalSongs songs
            · <strong>@result.Registry.Count unique</strong>
            · @(TotalSongs - result.Registry.Count) duplicates
        </p>

        @foreach (var playlist in result.Owned)
        {
            var rows = VisibleRows(playlist).ToList();
            if (IsFiltering && rows.Count == 0)
            {
                continue;
            }

            var duplicates = playlist.Entries.Count(e => e.Duplicate != DuplicateKind.None);

            <details class="playlist" open="@IsFiltering">
                <summary>
                    <span class="name">@playlist.Name</span>
                    <span class="meta">
                        @playlist.Entries.Count songs
                        @if (duplicates > 0)
                        {
                            <span class="badge">@duplicates duplicates</span>
                        }
                    </span>
                </summary>

                @if (rows.Count == 0)
                {
                    <p class="empty">No songs to show.</p>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th class="num">#</th><th>Title</th><th>Artist</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (entry, index) in rows)
                            {
                                <tr class="@(entry.Duplicate == DuplicateKind.None ? null : "dup")">
                                    <td class="num">@(index + 1)</td>
                                    <td>@entry.Track.Name</td>
                                    <td>@entry.Track.Artists</td>
                                    <td class="note">@DuplicateNote(entry)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (playlist.SkippedNonTracks > 0)
                {
                    <p class="hint">@playlist.SkippedNonTracks episodes, local files or unavailable items ignored.</p>
                }
            </details>
        }

        @if (result.NotOwned.Count > 0)
        {
            <details class="playlist skipped">
                <summary>
                    <span class="name">Skipped – not owned by you</span>
                    <span class="meta">@result.NotOwned.Count playlists</span>
                </summary>
                <ul>
                    @foreach (var p in result.NotOwned)
                    {
                        <li>@p.Name <span class="hint">by @p.OwnerName</span></li>
                    }
                </ul>
            </details>
        }
    }
}

@code {
    [SupplyParameterFromQuery]
    public string? LoginError { get; set; }

    private PlaylistLoader.Result? result;
    private bool loading;
    private string? status;
    private string? error;
    private bool hideDuplicates;
    private string filter = "";

    private int TotalSongs => result?.Owned.Sum(p => p.Entries.Count) ?? 0;

    private bool IsFiltering => !string.IsNullOrWhiteSpace(filter);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Load automatically once the interactive connection is up (runs only once, not during prerendering).
        if (firstRender && Auth.IsConfigured && Auth.IsLoggedIn && result is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        status = "Loading playlists …";
        StateHasChanged();

        try
        {
            result = await Loader.LoadOwnedPlaylistsAsync(message =>
            {
                status = message;
                _ = InvokeAsync(StateHasChanged);
            });
        }
        catch (NotLoggedInException ex)
        {
            // Session expired or revoked: the page falls back to the login card.
            result = null;
            error = ex.Message;
        }
        catch (SpotifyAuthException ex)
        {
            error = ex.Message;
        }
        catch (SpotifyApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            error = $"Network error: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<(PlaylistTrackEntry Entry, int Index)> VisibleRows(OwnedPlaylist playlist) =>
        playlist.Entries
            .Select((entry, index) => (entry, index))
            .Where(r => !hideDuplicates || r.entry.Duplicate == DuplicateKind.None)
            .Where(r => !IsFiltering
                        || r.entry.Track.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                        || r.entry.Track.Artists.Contains(filter, StringComparison.OrdinalIgnoreCase));

    private static string DuplicateNote(PlaylistTrackEntry entry) => entry.Duplicate switch
    {
        DuplicateKind.SamePlaylist => "Duplicate in this playlist",
        DuplicateKind.OtherPlaylist => $"Already in \"{entry.FirstSeenInPlaylist}\"",
        _ => "",
    };
}
